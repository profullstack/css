{
  "format": "profullstack.token-catalog/v1",
  "name": "Profullstack CSS tokens",
  "source": "../css/tokens.css",
  "prefix": "--pf-",
  "themes": ["light", "dark"],
  "tokens": {
    "color.canvas": { "cssVariable": "--pf-color-canvas", "type": "color", "light": "#f7f8fa", "dark": "#101719" },
    "color.surface": { "cssVariable": "--pf-color-surface", "type": "color", "light": "#ffffff", "dark": "#172123" },
    "color.surface-raised": { "cssVariable": "--pf-color-surface-raised", "type": "color", "light": "#ffffff", "dark": "#1d2a2c" },
    "color.ink": { "cssVariable": "--pf-color-ink", "type": "color", "light": "#14212b", "dark": "#eaf2ef" },
    "color.ink-muted": { "cssVariable": "--pf-color-ink-muted", "type": "color", "light": "#53616c", "dark": "#afbfba" },
    "color.border": { "cssVariable": "--pf-color-border", "type": "color", "light": "#d9e0e6", "dark": "#354648" },
    "color.primary": { "cssVariable": "--pf-color-primary", "type": "color", "light": "#126b55", "dark": "#6fd0aa" },
    "color.primary-hover": { "cssVariable": "--pf-color-primary-hover", "type": "color", "light": "#0d5846", "dark": "#89e2bb" },
    "color.on-primary": { "cssVariable": "--pf-color-on-primary", "type": "color", "light": "#ffffff", "dark": "#0d2920" },
    "color.accent": { "cssVariable": "--pf-color-accent", "type": "color", "light": "#f0a54a", "dark": "#ffc36d" },
    "color.danger": { "cssVariable": "--pf-color-danger", "type": "color", "light": "#b42332", "dark": "#ff8d98" },
    "color.success": { "cssVariable": "--pf-color-success", "type": "color", "light": "#176b45", "dark": "#79d6a7" },
    "color.warning": { "cssVariable": "--pf-color-warning", "type": "color", "light": "#8a4b00", "dark": "#ffcb78" },
    "color.info": { "cssVariable": "--pf-color-info", "type": "color", "light": "#175f9b", "dark": "#8fc8ff" },
    "color.focus": { "cssVariable": "--pf-color-focus", "type": "color", "light": "#126b55", "dark": "#89e2bb" },
    "shadow.sm": { "cssVariable": "--pf-shadow-sm", "type": "shadow", "light": "0 1px 2px rgb(15 32 43 / 8%)", "dark": "0 1px 2px rgb(0 0 0 / 25%)" },
    "shadow.md": { "cssVariable": "--pf-shadow-md", "type": "shadow", "light": "0 14px 38px rgb(15 32 43 / 10%)", "dark": "0 14px 38px rgb(0 0 0 / 25%)" },
    "radius.sm": { "cssVariable": "--pf-radius-sm", "type": "dimension", "value": "0.5rem" },
    "radius.md": { "cssVariable": "--pf-radius-md", "type": "dimension", "value": "0.85rem" },
    "radius.lg": { "cssVariable": "--pf-radius-lg", "type": "dimension", "value": "1.25rem" },
    "radius.pill": { "cssVariable": "--pf-radius-pill", "type": "dimension", "value": "999px" },
    "space.1": { "cssVariable": "--pf-space-1", "type": "dimension", "value": "0.25rem" },
    "space.2": { "cssVariable": "--pf-space-2", "type": "dimension", "value": "0.5rem" },
    "space.3": { "cssVariable": "--pf-space-3", "type": "dimension", "value": "0.75rem" },
    "space.4": { "cssVariable": "--pf-space-4", "type": "dimension", "value": "1rem" },
    "space.5": { "cssVariable": "--pf-space-5", "type": "dimension", "value": "1.5rem" },
    "space.6": { "cssVariable": "--pf-space-6", "type": "dimension", "value": "2rem" },
    "space.7": { "cssVariable": "--pf-space-7", "type": "dimension", "value": "3rem" },
    "space.8": { "cssVariable": "--pf-space-8", "type": "dimension", "value": "4rem" },
    "font.sans": { "cssVariable": "--pf-font-sans", "type": "fontFamily", "value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif" },
    "font.mono": { "cssVariable": "--pf-font-mono", "type": "fontFamily", "value": "SFMono-Regular, Consolas, Liberation Mono, monospace" },
    "text.xs": { "cssVariable": "--pf-text-xs", "type": "fontSize", "value": "0.78rem" },
    "text.sm": { "cssVariable": "--pf-text-sm", "type": "fontSize", "value": "0.9rem" },
    "text.md": { "cssVariable": "--pf-text-md", "type": "fontSize", "value": "1rem" },
    "text.lg": { "cssVariable": "--pf-text-lg", "type": "fontSize", "value": "1.2rem" },
    "text.xl": { "cssVariable": "--pf-text-xl", "type": "fontSize", "value": "clamp(1.6rem, 3vw, 2.4rem)" },
    "text.display": { "cssVariable": "--pf-text-display", "type": "fontSize", "value": "clamp(2.5rem, 6vw, 5.5rem)" },
    "leading.tight": { "cssVariable": "--pf-leading-tight", "type": "number", "value": 1.08 },
    "leading.normal": { "cssVariable": "--pf-leading-normal", "type": "number", "value": 1.6 },
    "content.width": { "cssVariable": "--pf-content-width", "type": "dimension", "value": "72rem" },
    "content.prose-width": { "cssVariable": "--pf-prose-width", "type": "dimension", "value": "68ch" },
    "control.height": { "cssVariable": "--pf-control-height", "type": "dimension", "value": "2.8rem" },
    "transition.fast": { "cssVariable": "--pf-transition-fast", "type": "transition", "value": "140ms ease" },
    "transition.normal": { "cssVariable": "--pf-transition-normal", "type": "transition", "value": "220ms ease" }
  }
}
